  "v028_architecture_contract": {
    "architecture_expansion_beyond_contract_permitted": false,
    "controller_equations": {
      "allocation_weights": {
        "required_sum": 1.0,
        "text": "s_t / (s_t + s_v)",
        "vision": "s_v / (s_t + s_v)"
      },
      "constants": {
        "allocation_exponent_beta": 2.0,
        "epsilon": 0.1,
        "interaction_exponent_gamma": 1.0
      },
      "inputs": {
        "c": "model-emitted cross-modal compatibility in [0,1]",
        "q_t": "model-emitted text quality in [0,1]",
        "q_v": "model-emitted vision quality in [0,1]"
      },
      "interaction_multiplier": "epsilon + (1 - epsilon) * (c ** gamma)",
      "parameter_free_controller": true,
      "selective_scores": {
        "text": "(epsilon + q_t) ** beta",
        "vision": "(epsilon + q_v) ** beta"
      },
      "separation_constraint": "Compatibility may affect the interaction multiplier but must not enter modality-weight allocation; modality quality may affect allocation but must not enter the compatibility interaction multiplier.",
      "stop_gradient_controller_inputs": true
    },
