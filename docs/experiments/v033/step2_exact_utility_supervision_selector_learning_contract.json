  "tensor_contract": {
    "batch_axis": "B",
    "delta_u": {
      "definition": "p_candidate_true - p_ref_true",
      "finite": true,
      "gradient": "DETACHED",
      "range": "[-1,1]",
      "shape": "[B]"
    },
    "p_candidate_true": {
      "dtype": "floating",
      "finite": true,
      "gradient": "DETACHED_FOR_UTILITY_TARGET",
      "range": "[0,1]",
      "shape": "[B]"
    },
    "p_ref_true": {
      "dtype": "floating",
      "finite": true,
      "gradient": "DETACHED_FOR_UTILITY_TARGET",
      "range": "[0,1]",
      "shape": "[B]"
    },
    "selector_output": {
      "definition": "sigmoid(selector_logit)",
      "finite": true,
      "name": "utility_probability",
      "range": "[0,1]",
      "shape": "[B]"
    },
    "u_target": {
      "anchor_examples": {
        "delta_u_+0.01": 0.55,
        "delta_u_+0.10": 1.0,
        "delta_u_-0.01": 0.45,
        "delta_u_-0.10": 0.0,
        "delta_u_0.00": 0.5
      },
      "definition": "clip(0.5 + delta_u / 0.20, 0.0, 1.0)",
      "directionality": "delta_u > 0 => u_target > 0.5; delta_u < 0 => u_target < 0.5",
      "finite": true,
      "neutral_point": 0.5,
      "range": "[0,1]",
      "shape": "[B]"
    }
  },
  "title": "Exact Utility-Supervision and Selector-Learning Mechanism Contract",
  "utility_loss": {
    "base_loss": "binary_cross_entropy_with_logits(selector_logit, u_target)",
    "effective_weight_assertion_required": true,
    "final_loss": "mean(per_sample_magnitude_weight * BCEWithLogits(selector_logit, u_target))",
    "per_sample_magnitude_weight": {
      "definition": "1.0 + 4.0 * min(abs(delta_u)/0.10, 1.0)",
      "purpose": "increase optimization signal for materially non-neutral counterfactual utility while retaining neutral examples",
      "range": "[1,5]"
    },
    "transition_objective_weight": 0.0,
    "utility_loss_weight": 0.5
  }
